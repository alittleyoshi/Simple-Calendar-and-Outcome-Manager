<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import ui.main.planning.PlanListPane?>
<fx:root type="javafx.scene.layout.AnchorPane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox minWidth="-Infinity" HBox.hgrow="NEVER">
                    <children>
                        <VBox VBox.vgrow="ALWAYS">
                            <children>
                                <ToggleButton fx:id="_planningTabButton" mnemonicParsing="false" prefHeight="50.0" prefWidth="50.0" selected="true" text="计划">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="_tabButtonGroup" />
                                    </toggleGroup>
                                    <VBox.margin>
                                        <Insets left="10.0" right="10.0" top="10.0" />
                                    </VBox.margin>
                                </ToggleButton>
                                <ToggleButton fx:id="_calendarTabButton" mnemonicParsing="false" prefHeight="50.0" prefWidth="50.0" text="日历" toggleGroup="$_tabButtonGroup">
                                    <VBox.margin>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </VBox.margin>
                                </ToggleButton>
                            </children>
                        </VBox>
                        <ToggleButton fx:id="_settingTabButton" mnemonicParsing="false" prefHeight="50.0" prefWidth="50.0" text="设置" toggleGroup="$_tabButtonGroup">
                            <VBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </VBox.margin>
                        </ToggleButton>
                    </children>
                </VBox>
                <AnchorPane HBox.hgrow="ALWAYS">
                    <children>
                        <PlanListPane fx:id="_planningPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                        <AnchorPane fx:id="_calendarPane" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <children>
                                <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <children>
                                        <ListView prefWidth="150.0" />
                                    </children>
                                </HBox>
                            </children>
                        </AnchorPane>
                        <AnchorPane fx:id="_settingPane" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                    </children>
                </AnchorPane>
            </children>
        </HBox>
    </children>
</fx:root>
