<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<fx:root type="javafx.scene.layout.AnchorPane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox maxHeight="-Infinity" maxWidth="-Infinity" spacing="10.0" style="-fx-background-radius: 7;">
                    <children>
                        <HBox>
                            <children>
                                <Label fx:id="_functionLabel">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <Label fx:id="_typeLabel">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label text="标题" />
                                <Label fx:id="_titleErrorHintLabel" text="请输入标题" textFill="RED" visible="false" />
                            </children>
                        </HBox>
                        <TextField fx:id="_titleText" promptText="一个容易记忆的标题" />
                        <Label text="描述" />
                        <TextArea fx:id="_descriptionText" promptText="对这个任务的描述和解释" wrapText="true" />
                        <Label text="开始时间" />
                        <DatePicker fx:id="_startDate" editable="false" promptText="开始时间" />
                        <Label text="结束时间" />
                        <DatePicker fx:id="_endDate" editable="false" promptText="结束时间" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </children></StackPane>
        <HBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onCancellingAction" prefHeight="40.0" prefWidth="80.0" text="取消" />
                <Button mnemonicParsing="false" onAction="#onConfirmedAction" prefHeight="40.0" prefWidth="80.0" text="确定" />
            </children>
        </HBox>
    </children>
</fx:root>
